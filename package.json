{
  "name": "oira666_pi-browser-agent",
  "version": "0.0.22",
  "private": false,
  "type": "module",
  "description": "Pi browser agent broker skeleton with lazy browser tool registration",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/gee666/pi-browser-agent.git"
  },
  "pi": {
    "extensions": [
      "./src/index.ts"
    ]
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "pretest": "npm run typecheck",
    "test": "node --test --test-concurrency=1 ./tests/*.test.ts ./tests/tools/*.test.ts",
    "test:integration": "node --test ./tests/integration/*.test.ts",
    "test:e2e": "node --test ./tests/pi-cli.e2e.ts",
    "test:evergreen": "npm test && npm run test:integration && npm run test:e2e"
  },
  "dependencies": {
    "ws": "^8.18.3"
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": ">=1.4.0",
    "typebox": "*"
  },
  "devDependencies": {
    "@earendil-works/pi-coding-agent": "1.4.0",
    "@types/node": "^26.6.5",
    "@types/ws": "^8.18.2",
    "typebox": "^1.4.3",
    "typescript": "^7.0.2"
  }
}
